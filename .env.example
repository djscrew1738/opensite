# OpenSite Environment Configuration

# Backend
NODE_ENV=development
PORT=5001

# Security Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Generate with: node -e "console.log('osk_' + Array(48).fill(0).map(() => 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'[Math.floor(Math.random() * 62)]).join(''))"
ADMIN_API_KEY=

# Ollama AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Frontend
VITE_API_URL=http://localhost:5001

# Company Information
COMPANY_NAME=CTL Plumbing LLC
SERVICE_AREA=DFW Metroplex

# ========== Permit Lead Finder Configuration ==========

# Permit Data Sources
SOCRATA_APP_TOKEN=

# AI Scoring Thresholds
HOT_SCORE_THRESHOLD=80
WARM_SCORE_THRESHOLD=50
MIN_PROJECT_COST=50000

# Service Area (for geographic filtering)
SERVICE_CENTER_LAT=32.7555
SERVICE_CENTER_LNG=-97.3308
SERVICE_RADIUS_MILES=25

# Notifications
PERMIT_NOTIFICATIONS_ENABLED=false
NOTIFY_PHONE_NUMBER=
NOTIFY_EMAIL=

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cron Job Schedules (Central Time)
# Format: "minute hour day month weekday"
PERMIT_INGEST_CRON=0 6 * * *
PERMIT_SCORING_CRON=5 6 * * *
PERMIT_ALERTS_CRON=10 6 * * *
PERMIT_DIGEST_CRON=0 8 * * *
PERMIT_ROLLUP_CRON=0 2 * * 0

# Job Control
PERMIT_JOBS_ENABLED=true
