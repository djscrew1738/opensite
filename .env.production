# Production Environment Configuration
# This file configures the app for public access at https://app.ctlplumbingllc.com

# ============================================
# BACKEND CONFIGURATION
# ============================================
NODE_ENV=production
PORT=5001
HOST=0.0.0.0

# CORS - Allow the production domain and Tailscale for local access
CORS_ORIGIN=https://app.cbrnholdings.com,https://app.ctlplumbingllc.com,http://app.ctlplumbingllc.com,http://100.83.120.32:3000,http://localhost:3000

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opensite

# Security
