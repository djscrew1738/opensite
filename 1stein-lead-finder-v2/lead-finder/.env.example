# ============================================================
# OPENSITE Lead Finder — Environment Configuration
# ============================================================

# PostgreSQL
DATABASE_URL=postgresql://localhost:5432/opensite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opensite
DB_USER=postgres
DB_PASSWORD=your_password_here

# Socrata API Token (free from data.fortworthtexas.gov)
SOCRATA_APP_TOKEN=

# Ollama (local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Twilio (Phase 3 - SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_PHONE_NUMBER=

# Email (Phase 3 - daily digest)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# Ingestion schedule (cron format - default: 6 AM daily)
INGEST_CRON=0 6 * * *
SCORING_CRON=0 7 * * *
DIGEST_CRON=0 8 * * *
ROLLUP_CRON=0 2 * * 0

# Lead scoring thresholds
HOT_SCORE_THRESHOLD=80
WARM_SCORE_THRESHOLD=50
MIN_PROJECT_COST=50000

# Service area - Fort Worth center coords
SERVICE_CENTER_LAT=32.7555
SERVICE_CENTER_LNG=-97.3308
SERVICE_RADIUS_MILES=25

# API server
API_PORT=3100

# Logging
LOG_LEVEL=info
