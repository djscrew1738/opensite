# OpenSite Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
PORT=5001
NODE_ENV=production
NODE_HEAP_MB=512
SERVER_IP=

# ============================================
# Admin Authentication (REQUIRED for admin endpoints)
# ============================================
# Generate a secure token with: node -e "console.log('atk_' + require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# ============================================
# Encryption (REQUIRED for sensitive data)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ============================================
# AI Provider API Keys
# ============================================
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OPENCLAW_URL=
OPENCLAW_TOKEN=

# ============================================
# Database
# ============================================
DB_PATH=

# ============================================
# File Upload Configuration
# ============================================
BASE_UPLOAD_DIR=
UPLOAD_DIR=

# ============================================
# IMAP/Email Configuration
# ============================================
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Use imap.outlook.com for @outlook.com personal accounts
# Use outlook.office365.com for Microsoft 365 / business accounts
IMAP_DEFAULT_HOST=imap.outlook.com
IMAP_DEFAULT_PORT=993
EMAIL_WATCHER_ENABLED=true

# ============================================
# OAuth - Microsoft (for Email Watcher + Outlook OAuth)
# ============================================
# Register app at https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://your-domain.com/api/email-alerts/auth/microsoft/callback

# ============================================
# OAuth - Google (for Email Watcher + Gmail OAuth)
# ============================================
# Register app at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/email-alerts/auth/google/callback

# ============================================
# Twilio (SMS Alerts)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_PHONE_NUMBER=

# ============================================
# Telegram (Optional Notifications)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# Blueprint Analysis Services
# ============================================
AECVISION_URL=http://localhost:8002
FLOORPLAN_URL=http://localhost:8003

# ============================================
# Redis (Optional - for job queue)
# ============================================
REDIS_URL=

# ============================================
# Weather API Configuration (NWS)
# ============================================
# Default: Fort Worth, TX (FWD/78,97)
NWS_OFFICE=FWD
NWS_GRID_X=78
NWS_GRID_Y=97

# ============================================
# Cache Configuration
# ============================================
CACHE_MAX_MAIN=500
CACHE_MAX_API=200
CACHE_MAX_STATIC=200

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Feature Flags
# ============================================
PERMIT_JOBS_ENABLED=true

# ============================================
# Automated Backups
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3

# ============================================
# Guest Account (disabled by default)
# ============================================
GUEST_ACCOUNT_ENABLED=false
GUEST_EMAIL=guest@ctlplumbingllc.com
GUEST_PASSWORD=
