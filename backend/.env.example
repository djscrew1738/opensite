# OpenSite Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
PORT=5001
NODE_ENV=production
NODE_HEAP_MB=512
SERVER_IP=

# ============================================
# Admin Authentication (REQUIRED for admin endpoints)
# ============================================
# Generate a secure token with: node -e "console.log('atk_' + require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# ============================================
# Encryption (REQUIRED for sensitive data)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ============================================
# AI Provider API Keys
# ============================================
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OPENCLAW_URL=
OPENCLAW_TOKEN=

# ============================================
# Database
# ============================================
DB_PATH=

# ============================================
# File Upload Configuration
# ============================================
BASE_UPLOAD_DIR=
UPLOAD_DIR=

# ============================================
# IMAP/Email Configuration
# ============================================
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_DEFAULT_HOST=outlook.office365.com
IMAP_DEFAULT_PORT=993
EMAIL_WATCHER_ENABLED=true

# ============================================
# Twilio (SMS Alerts)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_PHONE_NUMBER=

# ============================================
# Telegram (Optional Notifications)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# Redis (Optional - for job queue)
# ============================================
REDIS_URL=

# ============================================
# Weather API Configuration (NWS)
# ============================================
# Default: Fort Worth, TX (FWD/78,97)
NWS_OFFICE=FWD
NWS_GRID_X=78
NWS_GRID_Y=97

# ============================================
# Cache Configuration
# ============================================
CACHE_MAX_MAIN=500
CACHE_MAX_API=200
CACHE_MAX_STATIC=200

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Feature Flags
# ============================================
PERMIT_JOBS_ENABLED=true
