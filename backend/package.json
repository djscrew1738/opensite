{
  "name": "opensite-backend",
  "version": "1.1.2",
  "description": "Opensite Plumbing Intelligence Platform - Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=${NODE_HEAP_MB:-512} --watch src/server.js",
    "start": "node --max-old-space-size=${NODE_HEAP_MB:-512} src/server.js",
    "test": "node --test",
    "permits:ingest": "node -e \"import('./src/jobs/permit-jobs.js').then(m => m.manualIngest(7))\"",
    "permits:score": "node -e \"import('./src/jobs/permit-jobs.js').then(m => m.manualScore())\"",
    "permits:digest": "node -e \"import('./src/jobs/permit-jobs.js').then(m => m.manualDigest())\"",
    "permits:rollup": "node -e \"import('./src/jobs/permit-jobs.js').then(m => m.manualRollup())\"",
    "db:migrate": "node-pg-migrate"
  },
  "keywords": [
    "plumbing",
    "ai",
    "estimation",
    "crm"
  ],
  "author": "CTL Plumbing LLC",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^12.6.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "imapflow": "^1.2.10",
    "intuit-oauth": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "p-queue": "^8.0.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "twilio": "^5.3.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.16.0",
    "pdfkit": "^0.14.0",
    "csv-writer": "^1.6.0",
    "xlsx": "^0.18.5",
    "swagger-ui-express": "^5.0.0"
  }
}
