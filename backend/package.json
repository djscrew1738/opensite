{
  "name": "1stein-backend",
  "version": "1.1.2",
  "description": "1stein Plumbing Intelligence Platform - Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "permits:ingest": "node -e \"import('./src/jobs/permit-jobs.js').then(m => m.manualIngest(7))\"",
    "permits:score": "node -e \"import('./src/jobs/permit-jobs.js').then(m => m.manualScore())\"",
    "permits:digest": "node -e \"import('./src/jobs/permit-jobs.js').then(m => m.manualDigest())\"",
    "permits:rollup": "node -e \"import('./src/jobs/permit-jobs.js').then(m => m.manualRollup())\""
  },
  "keywords": [
    "plumbing",
    "ai",
    "estimation",
    "crm"
  ],
  "author": "CTL Plumbing LLC",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "p-queue": "^8.0.1",
    "pdf-parse": "^1.1.4",
    "twilio": "^5.3.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
