{
  "name": "CTL Daily Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5001/api/dashboard/stats"
      },
      "id": "fetch-stats",
      "name": "Fetch Dashboard Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5001/api/leads"
      },
      "id": "fetch-leads",
      "name": "Fetch Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 500]
    },
    {
      "parameters": {
        "jsCode": "const stats = $input.all()[0].json;\nconst leads = $input.all()[1].json.leads || [];\n\nconst today = new Date().toISOString().split('T')[0];\nconst todaysLeads = leads.filter(l => l.createdAt?.startsWith(today));\nconst hotLeads = leads.filter(l => l.status === 'hot' && !l.contacted);\n\nreturn [{\n  json: {\n    date: today,\n    totalLeads: leads.length,\n    newLeadsToday: todaysLeads.length,\n    hotLeads: hotLeads.length,\n    pipelineValue: stats.pipelineValue || 0,\n    activeProjects: stats.activeProjects || 0,\n    aiRequests: stats.aiRequests || 0\n  }\n}];"
      },
      "id": "aggregate-data",
      "name": "Aggregate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 400]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.FROM_EMAIL }}",
        "toEmail": "={{ $env.NOTIFICATION_EMAIL }}",
        "subject": "Daily Report - {{ $json.date }}",
        "text": "Daily Business Report - {{ $json.date }}\n\nLeads:\n- Total: {{ $json.totalLeads }}\n- New Today: {{ $json.newLeadsToday }}\n- Hot Leads Requiring Attention: {{ $json.hotLeads }}\n\nBusiness:\n- Pipeline Value: ${{ $json.pipelineValue }}\n- Active Projects: {{ $json.activeProjects }}\n- AI Requests Today: {{ $json.aiRequests }}"
      },
      "id": "send-report",
      "name": "Send Daily Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Daily at 8am": {
      "main": [
        [
          {
            "node": "Fetch Dashboard Stats",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Dashboard Stats": {
      "main": [
        [
          {
            "node": "Aggregate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Leads": {
      "main": [
        [
          {
            "node": "Aggregate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Data": {
      "main": [
        [
          {
            "node": "Send Daily Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["reporting", "daily", "ctl-plumbing"]
}
